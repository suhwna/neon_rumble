{
  "name": "neon-rumble-online",
  "version": "1.1.0-beta.7",
  "private": true,
  "description": "Online 4-player browser platform brawler",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
